---
import Logo from '../assets/theme-images/logo.svg'
import demos from '../data/demos.json'

const { settings } = Astro.props
---

<footer class="bs-container my-16 md:my-24 font-semibold text-bs-foreground-dark [&_a]:hover:text-bs-foreground-light [&_a]:transition-colors" id="contact">
  <div class="bg-bs-surface-0 border border-ulogix-line p-6 md:p-12 grid md:grid-cols-2 gap-10">
    <div class="flex flex-col gap-6 text-bs-foreground-light">
      <a class="flex items-center gap-3 group w-fit" href="/" aria-label="Ulogix — Inicio">
        <Logo class="group-hover:-rotate-180 transition-transform ease-bs-spring duration-1000" height="40" width="40" />
        <span class="font-display text-xl">Ulogix</span>
      </a>
      <p class="text-bs-foreground-dark font-normal text-sm max-w-sm leading-relaxed">
        Propuesta de automatización para Coca-Cola FEMSA Fontibón · APM 2026 · Universidad Nacional de Colombia.
      </p>
      <button type="button" class="min-w-32 bs-btn w-fit bg-bs-surface-3" onclick="demo.showModal()">
        {settings.demo.cta}
      </button>
    </div>

    <div class="flex flex-wrap gap-10 md:justify-end">
      <nav class="flex flex-col gap-1">
        <p class="text-xs uppercase tracking-wider text-ulogix-accent mb-2">Sitio</p>
        {settings.nav.map((item) => (
          <a class="py-1 font-normal" href={item.link}>{item.title}</a>
        ))}
        <a class="py-1 font-normal" href="/informe-proceso">Informe de proceso</a>
      </nav>
      <nav class="flex flex-col gap-1">
        <p class="text-xs uppercase tracking-wider text-ulogix-accent mb-2">Demos</p>
        {demos.map((d) => (
          <a class="py-1 font-normal" href={d.url} target="_blank" rel="noopener">{d.title}</a>
        ))}
      </nav>
      <nav class="flex flex-col gap-1">
        <p class="text-xs uppercase tracking-wider text-ulogix-accent mb-2">Enlaces</p>
        {settings.social_links.map((item) => (
          <a class="py-1 font-normal" href={item.link} target="_blank" rel="noopener">{item.title}</a>
        ))}
      </nav>
    </div>
  </div>

  <aside class="flex gap-4 justify-center pt-10 text-xs font-normal">
    <span>© {new Date().getFullYear()} Ulogix</span>
    <a href="/credits">Créditos</a>
  </aside>
</footer>
