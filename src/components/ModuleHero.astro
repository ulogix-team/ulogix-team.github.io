---
import { Image } from 'astro:assets'

const { number, title, subtitle, rubric, image, imageAlt = '' } = Astro.props
---

<section class="relative min-h-[65svh] md:min-h-[78svh] flex items-end overflow-hidden">
  <div class="absolute inset-0">
    {image ? (
      <Image
        src={image}
        alt={imageAlt}
        class="w-full h-full object-cover"
        widths={[800, 1200, 1800]}
        sizes="100vw"
        loading="eager"
      />
    ) : (
      <div class="w-full h-full bg-bs-surface-3"></div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/70 to-black/25"></div>
  </div>

  <div class="bs-container relative z-10 pb-14 md:pb-20 pt-32 w-full">
    <p class="text-sm tracking-wide text-ulogix-accent mb-4">
      Módulo {number}
    </p>
    <h1 class="bs-h1 max-w-4xl text-white tracking-tight">{title}</h1>
    {subtitle && (
      <p class="mt-5 max-w-2xl text-lg md:text-xl text-white/70 leading-relaxed">
        {subtitle}
      </p>
    )}
    {rubric && (
      <aside class="mt-10 max-w-2xl rounded-2xl border border-white/10 bg-black/50 p-5 md:p-6">
        <p class="text-xs uppercase tracking-wider text-ulogix-accent mb-2 font-semibold">Rúbrica</p>
        <p class="text-sm md:text-base text-white/75 leading-relaxed">{rubric}</p>
      </aside>
    )}
  </div>
</section>
