---
/**
 * Flip card — front / back on hover (and focus for a11y)
 */
const { frontTitle, frontMeta, backTitle, backBody, index } = Astro.props
---

<div class="flip-card group" tabindex="0">
  <div class="flip-card-inner">
    <div class="flip-card-face flip-card-front">
      {index !== undefined && (
        <span class="text-ulogix-accent text-xs tracking-widest font-mono mb-3 block">{String(index).padStart(2, '0')}</span>
      )}
      {frontMeta && <p class="text-xs text-bs-foreground-dark uppercase tracking-wider mb-2">{frontMeta}</p>}
      <div class="flip-card-front-body">
        <slot name="front" />
        {frontTitle && <p class="font-display text-xl md:text-2xl text-white leading-snug">{frontTitle}</p>}
      </div>
      <p class="mt-auto pt-4 text-[11px] text-ulogix-accent/80 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity">
        Ver más →
      </p>
    </div>
    <div class="flip-card-face flip-card-back">
      {backTitle && <p class="text-ulogix-accent text-sm font-medium mb-3">{backTitle}</p>}
      <slot name="back" />
      {backBody && <p class="text-sm text-white/80 leading-relaxed">{backBody}</p>}
    </div>
  </div>
</div>

<style>
  .flip-card {
    perspective: 1200px;
    min-height: 11.5rem;
    height: 100%;
  }

  .flip-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 11.5rem;
    transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    transform-style: preserve-3d;
  }

  .flip-card:hover .flip-card-inner,
  .flip-card:focus-within .flip-card-inner {
    transform: rotateY(180deg);
  }

  .flip-card-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.35rem 1.4rem;
    display: flex;
    flex-direction: column;
  }

  .flip-card-front {
    background: linear-gradient(160deg, rgba(29, 29, 31, 0.9), rgba(10, 10, 10, 0.75));
  }

  .flip-card-back {
    background: linear-gradient(160deg, rgba(0, 113, 227, 0.22), rgba(10, 10, 10, 0.92));
    border-color: rgba(41, 151, 255, 0.28);
    transform: rotateY(180deg);
    overflow: auto;
  }

  .flip-card-front-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>
