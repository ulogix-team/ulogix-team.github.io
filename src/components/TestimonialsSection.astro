---
const { title, testimonials } = Astro.props
---

<section class="bs-container py-20 md:py-28">
  {title && (
    <>
      <p class="font-mono text-xs tracking-widest text-ulogix-accent uppercase mb-3">Testimonios</p>
      <h2 class="bs-h2 mb-10">{title}</h2>
    </>
  )}

  <div class="group grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {testimonials.map((item) => (
      <blockquote
        class:list={[
          "ulogix-glass rounded-3xl p-5 md:p-6 flex flex-col gap-4 justify-between transition-all duration-300 group-hover:opacity-70 hover:opacity-100! hover:scale-[1.03] hover:border-ulogix-accent/40",
          item.quote.length > 100 ? "lg:col-span-2" : "",
        ]}
      >
        <p
          set:html={item.quote}
          class:list={["text-sm md:text-base leading-relaxed text-white/90", item.quote.length > 100 ? "line-clamp-5 lg:line-clamp-none" : ""]}
        />
        <cite class="not-italic text-ulogix-accent text-sm font-semibold">@{item.handle}</cite>
      </blockquote>
    ))}
  </div>
</section>
