---
import demos from '../data/demos.json'

const { demoId, title, body } = Astro.props
const demo = demos.find((d) => d.id === demoId)
---

{demo && (
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 border border-ulogix-line bg-bs-surface-0 px-6 py-8 md:px-10 md:py-10">
    <div class="max-w-xl">
      <p class="font-mono text-xs tracking-widest text-ulogix-accent uppercase mb-2">Live · Hetzner / Docker</p>
      <h3 class="bs-h3 text-bs-foreground-light">{title ?? demo.title}</h3>
      <p class="text-bs-foreground-dark mt-2">{body ?? demo.subtitle}</p>
    </div>
    <a
      href={demo.url}
      target="_blank"
      rel="noopener noreferrer"
      class="bs-btn bg-ulogix-accent-strong! text-white! hover:brightness-110 shrink-0"
    >
      Abrir {demo.title} →
    </a>
  </div>
)}
