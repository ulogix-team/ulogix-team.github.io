---
const { content, image, cite, role } = Astro.props
---

<blockquote class="bs-container py-20 md:py-28" id="quote">
  <div class="ulogix-glass ulogix-glow rounded-[2rem] p-8 md:p-14 max-w-5xl">
    <div set:html={content} class="font-display text-2xl md:text-4xl lg:text-5xl leading-snug text-white/90 bs-st-quote [&_strong]:text-ulogix-accent [&_strong]:font-semibold" />
    <cite class="not-italic flex gap-4 items-center mt-10">
      <img src={image} class="h-14 w-14 rounded-full ring-1 ring-white/20 object-cover" alt="" width="128" height="128" loading="lazy" />
      <div>
        <p class="text-white font-semibold text-lg">{cite}</p>
        <p class="text-bs-foreground-dark text-sm">{role}</p>
      </div>
    </cite>
  </div>
</blockquote>
