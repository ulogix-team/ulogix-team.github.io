---
const { title, clients } = Astro.props
---

<section class="bg-[#f5f5f7] text-gray-900 py-16 md:py-24">
  <div class="bs-container">
    {title && (
      <div class="text-center mb-4">
        <p class="text-xs tracking-widest text-blue-600 uppercase mb-3 font-medium">Partners</p>
        <h2 class="bs-h2 text-gray-900" set:html={title} />
      </div>
    )}

    <div class="mt-10 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      {clients.map((item) => (
        <a
          class="group rounded-2xl py-10 px-5 flex place-content-center bg-white border border-gray-200 hover:border-blue-300 hover:shadow-md transition-all duration-300"
          href={item.link}
          target="_blank"
          rel="noopener"
        >
          <img
            src={item.image}
            alt={item.title}
            class="opacity-60 max-w-28 min-h-12 object-contain group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
            width="140"
            height="40"
            loading="lazy"
          />
        </a>
      ))}
    </div>
  </div>
</section>
