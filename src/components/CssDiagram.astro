---
/**
 * Visual CSS diagrams for module pages.
 * Variants: isa95 | oee | dual-cells | factory-flow | grafcet | scada | mes | erp | uns | architecture
 */
const { variant = 'isa95', title } = Astro.props
---

<figure class="css-diagram ulogix-glass ulogix-glow rounded-3xl p-6 md:p-10 overflow-hidden relative">
  {title && <figcaption class="text-sm font-medium text-ulogix-accent mb-6 tracking-wide">{title}</figcaption>}

  {variant === 'isa95' && (
    <div class="flex flex-col items-center gap-2 max-w-lg mx-auto">
      {[
        { l: '4', n: 'ERP', d: 'Planeación · inventario · finanzas' },
        { l: '3', n: 'MES', d: 'Ejecución · OEE · calidad · lotes' },
        { l: '2', n: 'SCADA / HMI', d: 'Ignition · ISA-101 · OPC UA' },
        { l: '1–2', n: 'Control PLC', d: 'Grafcet · Ladder · Logix Emulate' },
        { l: '0–1', n: 'Campo', d: 'Sensores · robots · actuadores' },
      ].map((row, i) => (
        <div
          class="w-full text-center py-3 md:py-4 rounded-xl border border-white/10 transition-transform hover:scale-[1.02]"
          style={`width: ${100 - i * 8}%; background: linear-gradient(90deg, rgba(41,151,255,${0.35 - i * 0.05}), rgba(10,132,255,${0.25 - i * 0.03}));`}
        >
          <p class="font-mono text-[10px] text-white/60">Nivel {row.l}</p>
          <p class="font-semibold text-white">{row.n}</p>
          <p class="text-xs text-white/70 hidden sm:block">{row.d}</p>
        </div>
      ))}
    </div>
  )}

  {variant === 'oee' && (
    <div class="grid md:grid-cols-3 gap-4">
      {[
        { label: 'Disponibilidad', value: 'D', color: '#2997ff' },
        { label: 'Eficiencia', value: 'E', color: '#64d2ff' },
        { label: 'Calidad', value: 'C', color: '#5ac8fa' },
      ].map((f) => (
        <div class="rounded-2xl p-6 text-center border border-white/10" style={`background: radial-gradient(circle at 50% 0%, ${f.color}44, transparent 70%)`}>
          <div class="mx-auto mb-4 w-20 h-20 rounded-full border-4 flex items-center justify-center text-2xl font-bold" style={`border-color: ${f.color}`}>{f.value}</div>
          <p class="font-medium">{f.label}</p>
        </div>
      ))}
      <div class="md:col-span-3 rounded-2xl p-6 text-center bg-gradient-to-r from-blue-600/25 to-blue-900/20 border border-white/10">
        <p class="text-sm text-white/70 mb-1">OEE = D × E × C</p>
        <p class="text-4xl font-display font-semibold ulogix-gradient-text">≈ 83 % base</p>
        <p class="text-sm text-white/60 mt-2">Meta: +3 a +5 puntos · foco en D y E</p>
      </div>
    </div>
  )}

  {variant === 'dual-cells' && (
    <div class="grid md:grid-cols-2 gap-6">
      <div class="rounded-2xl p-6 border border-white/10 bg-gradient-to-br from-blue-600/20 to-zinc-900/40">
        <div class="h-28 mb-4 relative flex items-end justify-center gap-2">
          <div class="w-2/3 h-3 rounded bg-blue-300/70 absolute top-4"></div>
          <div class="w-2 h-20 bg-gradient-to-t from-blue-400 to-sky-300 rounded"></div>
          <div class="absolute bottom-0 left-4 right-4 flex gap-2">
            <div class="flex-1 h-8 rounded bg-white/10 border border-white/20"></div>
            <div class="flex-1 h-8 rounded bg-white/10 border border-white/20"></div>
            <div class="flex-1 h-8 rounded bg-white/10 border border-white/20"></div>
          </div>
        </div>
        <h3 class="text-lg font-semibold">Gantry · L1 + L2</h3>
        <p class="text-sm text-white/70 mt-1">Paletizado alternado · 2 ejes · OPC a Ignition</p>
      </div>
      <div class="rounded-2xl p-6 border border-white/10 bg-gradient-to-br from-sky-600/15 to-zinc-900/40">
        <div class="h-28 mb-4 relative flex items-center justify-center">
          <div class="w-16 h-16 rounded-full border-2 border-sky-300/50 relative">
            <div class="absolute inset-2 rounded-full bg-gradient-to-br from-sky-400/30 to-blue-500/30"></div>
            <div class="absolute -right-8 top-1/2 w-12 h-2 bg-sky-300/70 rounded origin-left -rotate-12"></div>
            <div class="absolute -right-14 top-[40%] w-8 h-2 bg-sky-200/60 rounded rotate-45"></div>
          </div>
        </div>
        <h3 class="text-lg font-semibold">IRB 5710 · L3</h3>
        <p class="text-sm text-white/70 mt-1">6 ejes · gripper + ventosas · garrafones 25 L</p>
      </div>
    </div>
  )}

  {variant === 'factory-flow' && (
    <div class="flex flex-col md:flex-row items-stretch gap-3 md:gap-0">
      {[
        { t: 'RobotStudio', s: 'Trayectorias' },
        { t: 'Siemens NX', s: 'Gemelo + tiempos' },
        { t: 'Tecnomatix', s: 'Planta + KPIs' },
        { t: 'UNS / MES', s: 'Indicadores vivos' },
      ].map((step, i, arr) => (
        <div class="flex-1 flex items-center">
          <div class="flex-1 rounded-2xl p-5 text-center border border-white/10 bg-gradient-to-b from-blue-500/15 to-transparent">
            <p class="font-mono text-[10px] text-ulogix-accent mb-1">0{i + 1}</p>
            <p class="font-semibold">{step.t}</p>
            <p class="text-xs text-white/60 mt-1">{step.s}</p>
          </div>
          {i < arr.length - 1 && (
            <div class="hidden md:block w-6 h-px bg-gradient-to-r from-blue-400 to-sky-400 mx-1 shrink-0"></div>
          )}
        </div>
      ))}
    </div>
  )}

  {variant === 'grafcet' && (
    <div class="grid md:grid-cols-4 gap-4 items-center">
      {['Grafcet N1', 'Grafcet N2', 'Grafcet N3', 'Ladder'].map((s, i) => (
        <div class="relative">
          <div class={`rounded-2xl p-5 text-center border ${i === 3 ? 'border-ulogix-accent/40 bg-gradient-to-br from-blue-500/20 to-zinc-800/40' : 'border-white/10 bg-blue-500/10'}`}>
            <div class="mx-auto mb-3 w-10 h-10 rounded-lg border-2 border-dashed border-white/40 flex items-center justify-center text-xs font-mono">{i < 3 ? 'G' : 'LD'}</div>
            <p class="font-medium text-sm">{s}</p>
            <p class="text-[11px] text-white/55 mt-1">{i < 3 ? 'IEC 60848' : 'IEC 61131-3'}</p>
          </div>
          {i < 3 && <div class="hidden md:block absolute -right-3 top-1/2 w-4 h-px bg-blue-400/60" />}
        </div>
      ))}
    </div>
  )}

  {variant === 'scada' && (
    <div class="space-y-3">
      <div class="rounded-xl p-4 bg-gradient-to-r from-blue-500/15 to-zinc-800/30 border border-white/10 text-center font-medium">Layout de planta</div>
      <div class="grid grid-cols-3 gap-3">
        {['Línea 1', 'Línea 2', 'Línea 3'].map((l) => (
          <div class="rounded-xl p-4 border border-white/10 bg-white/5 text-center text-sm">{l}</div>
        ))}
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
        {['Temp.', 'Válvulas', 'Motores', 'Robots'].map((t) => (
          <div class="rounded-lg py-3 px-2 text-center text-xs border border-white/10 bg-blue-500/10">{t}</div>
        ))}
      </div>
      <p class="text-center text-xs text-white/50 pt-2">ISA-101 · drill-down · setpoints · históricos</p>
    </div>
  )}

  {variant === 'mes' && (
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      {[
        { t: 'Órdenes', i: '01' },
        { t: 'OEE', i: '02' },
        { t: 'Calidad', i: '03' },
        { t: 'Lotes', i: '04' },
      ].map((c) => (
        <div class="rounded-2xl aspect-square flex flex-col items-center justify-center border border-white/10 bg-gradient-to-br from-blue-500/15 to-indigo-900/30 hover:scale-105 transition-transform">
          <span class="font-mono text-ulogix-accent mb-2">{c.i}</span>
          <span class="font-medium text-sm">{c.t}</span>
        </div>
      ))}
    </div>
  )}

  {variant === 'erp' && (
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
      {['Pronóstico', 'Inventario', 'BOM', 'Compras', 'Producción', 'Finanzas'].map((m) => (
        <div class="rounded-xl py-5 px-4 text-center border border-white/10 bg-gradient-to-b from-blue-500/12 to-transparent font-medium text-sm">
          {m}
        </div>
      ))}
    </div>
  )}

  {variant === 'uns' && (
    <div class="relative py-8">
      <div class="absolute left-1/2 top-4 bottom-4 w-1 -translate-x-1/2 rounded-full bg-gradient-to-b from-blue-400 to-sky-500 opacity-80"></div>
      <div class="grid grid-cols-2 gap-x-16 gap-y-4 max-w-md mx-auto relative">
        {['Campo / Robots', 'PLC', 'SCADA', 'MES', 'Analítica', 'ERP'].map((n, i) => (
          <div class={`rounded-xl py-3 px-4 text-sm text-center border border-white/15 bg-bs-surface-0/80 ${i % 2 === 1 ? 'translate-y-2' : ''}`}>
            {n}
          </div>
        ))}
      </div>
      <div class="relative z-10 mx-auto mt-6 w-fit rounded-full px-5 py-2 text-sm font-semibold bg-ulogix-accent-strong text-white">
        MQTT Broker · UNS
      </div>
    </div>
  )}

  {variant === 'architecture' && (
    <div class="flex flex-col gap-2 text-center text-sm">
      <div class="rounded-xl py-3 bg-gradient-to-r from-blue-500/15 to-zinc-800/30 border border-white/10">ERP ←→ MES</div>
      <div class="text-ulogix-accent">↕ MQTT / APIs</div>
      <div class="rounded-xl py-3 bg-gradient-to-r from-blue-500/15 to-zinc-800/30 border border-white/10">UNS · Mosquitto</div>
      <div class="text-ulogix-accent">↕ OPC UA · Node-RED</div>
      <div class="rounded-xl py-3 bg-gradient-to-r from-blue-500/15 to-zinc-800/30 border border-white/10">Ignition SCADA · PLC · Gemelo · Robots</div>
    </div>
  )}

  {variant === 'middleware' && (
    <div class="space-y-6">
      <div class="flex flex-col md:flex-row md:items-center gap-3 md:gap-2 justify-center">
        {[
          { t: 'Logix Emulate', s: 'OPC DA' },
          { t: 'Node-RED', s: 'Middleware', hot: true },
          { t: 'Ignition', s: 'OPC UA' },
          { t: 'MQTT Broker', s: 'UNS' },
          { t: 'MES / ERP', s: 'IT' },
        ].map((n, i) => (
          <div class="flex items-center gap-2 md:gap-2 w-full md:w-auto">
            <div class={`flex-1 md:flex-none md:min-w-[7.5rem] rounded-2xl p-4 border text-center ${n.hot ? 'border-ulogix-accent/50 bg-gradient-to-br from-blue-600/25 to-zinc-900/50' : 'border-white/10 bg-white/5'}`}>
              <p class="font-semibold text-sm">{n.t}</p>
              <p class="text-[11px] text-white/55 mt-1">{n.s}</p>
            </div>
            {i < 4 && <span class="hidden md:inline text-ulogix-accent shrink-0">→</span>}
            {i < 4 && <span class="md:hidden text-ulogix-accent mx-auto">↓</span>}
          </div>
        ))}
      </div>
      <div class="flex flex-wrap justify-center gap-2 text-xs text-white/60">
        <span class="px-3 py-1 rounded-full border border-white/15">OPC DA → OPC UA</span>
        <span class="px-3 py-1 rounded-full border border-white/15">Normaliza tags</span>
        <span class="px-3 py-1 rounded-full border border-white/15">Publica a Mosquitto</span>
        <span class="px-3 py-1 rounded-full border border-white/15">Flujos visuales</span>
      </div>
      <p class="text-center text-sm text-white/70 max-w-2xl mx-auto">
        Node-RED es el puente: Logix Emulate habla OPC DA; Ignition, el gemelo y el UNS hablan OPC UA / MQTT.
      </p>
    </div>
  )}

  {variant === 'comms' && (
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { t: 'OPC UA', d: 'Bus industrial de planta · Ignition server' },
        { t: 'OPC DA', d: 'Legacy PLC / Logix Emulate' },
        { t: 'MQTT', d: 'UNS · pub/sub semántico' },
        { t: 'HTTP / API', d: 'MES engine · ERP' },
      ].map((c) => (
        <div class="rounded-2xl p-5 border border-white/10 bg-gradient-to-b from-blue-500/12 to-transparent">
          <p class="font-semibold text-ulogix-accent">{c.t}</p>
          <p class="text-sm text-white/65 mt-2">{c.d}</p>
        </div>
      ))}
    </div>
  )}
</figure>
