---
/**
 * Module section renderer — creative layouts + flip cards
 */
import DemoPanel from './DemoPanel.astro'
import CssDiagram from './CssDiagram.astro'
import FlipCard from './FlipCard.astro'

const diagramImages = import.meta.glob('../assets/logos/*.{png,jpg,jpeg,PNG}', {
  eager: true,
  import: 'default',
})

function resolveDiagram(filename) {
  if (!filename) return null
  const entry = Object.entries(diagramImages).find(([path]) => path.endsWith(filename))
  return entry ? entry[1] : null
}

function shortTitle(text, words = 5) {
  const parts = String(text).split(' ')
  if (parts.length <= words) return text
  return parts.slice(0, words).join(' ') + '…'
}

const { sections = [], demoId } = Astro.props
---

<div class="bs-container flex flex-col gap-24 md:gap-32 py-16 md:py-24">
  {sections.map((section, sIdx) => (
    <section class:list={['module-section relative', sIdx % 2 === 1 && 'md:pl-6']}>
      {section.title && section.type !== 'demo' && (
        <div class="mb-10 max-w-3xl">
          <p class="text-ulogix-accent text-xs tracking-[0.2em] uppercase mb-3">
            {String(sIdx + 1).padStart(2, '0')}
          </p>
          <h2 class="bs-h2">{section.title}</h2>
        </div>
      )}

      {section.type === 'prose' && (
        <div class:list={[
          'relative',
          sIdx % 2 === 0 ? 'md:max-w-3xl' : 'md:ml-auto md:max-w-3xl md:text-right',
        ]}>
          <div class:list={[
            'absolute top-0 w-px h-full bg-gradient-to-b from-ulogix-accent/50 to-transparent',
            sIdx % 2 === 0 ? '-left-6' : '-right-6 max-md:hidden',
          ]} />
          <p class="text-bs-foreground-dark text-lg md:text-xl leading-relaxed">
            {section.body}
          </p>
        </div>
      )}

      {section.type === 'css-diagram' && (
        <div class="relative -mx-2 md:mx-0">
          <CssDiagram variant={section.variant} title={section.diagramTitle} />
        </div>
      )}

      {section.type === 'tech-logos' && (
        <div>
          {section.body && (
            <p class="text-bs-foreground-dark text-lg max-w-3xl mb-10 leading-relaxed">{section.body}</p>
          )}
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-5">
            {section.items.map((item) => (
              <FlipCard frontTitle={item.title} backTitle={item.title} backBody={`Parte del stack Ulogix · ${item.title}`}>
                <div slot="front" class="flex justify-center w-full">
                  <img
                    src={`/tech/${item.file}`}
                    alt={item.title}
                    class:list={[
                      'max-h-14 max-w-[7rem] object-contain mb-2',
                      item.invert && 'brightness-0 invert opacity-90',
                    ]}
                    loading="lazy"
                  />
                </div>
                <div slot="back">
                  <img
                    src={`/tech/${item.file}`}
                    alt=""
                    class:list={[
                      'max-h-8 max-w-[5rem] object-contain mb-4 opacity-70',
                      item.invert && 'brightness-0 invert',
                    ]}
                    loading="lazy"
                  />
                  <p class="text-sm text-white/80 leading-relaxed">
                    Integrado en la arquitectura ISA-95 / UNS de la propuesta FEMSA.
                  </p>
                </div>
              </FlipCard>
            ))}
          </div>
        </div>
      )}

      {section.type === 'photo-grid' && (
        <div>
          {section.body && (
            <p class="text-bs-foreground-dark text-lg max-w-3xl mb-10 leading-relaxed">{section.body}</p>
          )}
          <div class="grid grid-cols-12 gap-4 md:gap-5 auto-rows-[12rem] md:auto-rows-[14rem]">
            {section.items.map((item, i) => (
              <figure
                class:list={[
                  'group relative overflow-hidden rounded-3xl border border-ulogix-line',
                  i === 0 ? 'col-span-12 md:col-span-7 md:row-span-2 md:auto-rows-auto min-h-[16rem]' : 'col-span-12 sm:col-span-6 md:col-span-5',
                ]}
              >
                <img
                  src={`/tech/${item.file}`}
                  alt={item.title}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  loading="lazy"
                />
                <figcaption class="absolute inset-x-0 bottom-0 p-5 bg-gradient-to-t from-black/85 via-black/40 to-transparent">
                  <p class="font-display text-lg text-white">{item.title}</p>
                  {item.caption && <p class="text-xs text-white/65 mt-1">{item.caption}</p>}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      )}

      {section.type === 'callout' && (
        <div class="relative max-w-3xl rounded-3xl border border-ulogix-accent/25 bg-ulogix-accent-soft px-7 py-9 md:px-12 overflow-hidden">
          <div class="absolute -right-8 -top-8 w-32 h-32 rounded-full bg-ulogix-accent/10" />
          <p class="relative text-bs-foreground-light text-lg md:text-xl leading-relaxed">{section.body}</p>
        </div>
      )}

      {section.type === 'bullets' && (
        <div class="grid md:grid-cols-2 gap-x-10 gap-y-5 max-w-5xl">
          {section.items.map((item, i) => (
            <div class="flex gap-4 items-start group">
              <span class="shrink-0 w-8 h-8 rounded-full border border-ulogix-line flex items-center justify-center text-xs text-ulogix-accent font-mono group-hover:border-ulogix-accent transition-colors">
                {String(i + 1).padStart(2, '0')}
              </span>
              <p class="text-bs-foreground-dark leading-relaxed pt-1">{item}</p>
            </div>
          ))}
        </div>
      )}

      {section.type === 'objectives' && (
        <div class="grid sm:grid-cols-2 gap-4 md:gap-5">
          {section.items.map((item, i) => (
            <FlipCard
              index={i + 1}
              frontTitle={shortTitle(item, 6)}
              backTitle="Detalle"
              backBody={item}
            />
          ))}
        </div>
      )}

      {section.type === 'levels' && (
        <div class="relative space-y-3 max-w-4xl">
          <div class="absolute left-[1.15rem] top-4 bottom-4 w-px bg-gradient-to-b from-ulogix-accent via-ulogix-accent/30 to-transparent md:hidden" />
          {section.items.map((item, i) => (
            <div
              class="grid md:grid-cols-[5.5rem_9rem_1fr] gap-3 md:gap-6 items-start rounded-2xl border border-ulogix-line/80 bg-black/30 px-5 py-5 md:px-7 md:py-6 hover:border-ulogix-accent/35 transition-colors"
              style={`margin-left: ${Math.min(i, 4) * 0.35}rem`}
            >
              <span class="font-mono text-ulogix-accent text-sm pt-0.5">Nv {item.level}</span>
              <strong class="text-white text-lg">{item.name}</strong>
              <p class="text-bs-foreground-dark leading-relaxed text-sm md:text-base">{item.desc}</p>
            </div>
          ))}
        </div>
      )}

      {section.type === 'diagrams' && (
        <div>
          {section.body && (
            <p class="text-bs-foreground-dark text-lg max-w-3xl mb-10 leading-relaxed">{section.body}</p>
          )}
          <div class="columns-1 sm:columns-2 lg:columns-3 gap-5 space-y-5">
            {section.items.map((item) => {
              const img = resolveDiagram(item.image)
              return (
                <figure class="break-inside-avoid rounded-2xl overflow-hidden border border-ulogix-line bg-black/40">
                  {img ? (
                    <img src={typeof img === 'string' ? img : img.src} alt={item.title} class="w-full object-contain bg-white p-2" loading="lazy" />
                  ) : (
                    <div class="aspect-[4/3] flex items-center justify-center text-bs-foreground-dark text-sm">Sin imagen</div>
                  )}
                  <figcaption class="px-4 py-3 text-sm font-medium">{item.title}</figcaption>
                </figure>
              )
            })}
          </div>
        </div>
      )}

      {section.type === 'compare' && (
        <div class="grid md:grid-cols-2 gap-0 md:gap-0 rounded-3xl overflow-hidden border border-ulogix-line">
          {[section.before, section.after].map((col, idx) => (
            <div class:list={['p-7 md:p-10', idx === 1 ? 'bg-ulogix-accent-soft border-t md:border-t-0 md:border-l border-ulogix-line' : 'bg-black/40']}>
              <h3 class:list={['font-display text-xl mb-6', idx === 1 && 'text-ulogix-accent']}>{col.title}</h3>
              <ul class="flex flex-col gap-3">
                {col.items.map((item) => (
                  <li class="flex gap-3 text-bs-foreground-dark text-sm md:text-base">
                    <span class={idx === 1 ? 'text-ulogix-accent' : 'opacity-40'}>▸</span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}

      {section.type === 'metrics' && (
        <div>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 mb-10">
            {[
              { label: 'OEE base', value: `${section.oee?.oeeTotal ?? 83} %` },
              { label: 'Disponibilidad*', value: `${section.oee?.disponibilidad ?? '—'} %` },
              { label: 'Eficiencia*', value: `${section.oee?.eficencia ?? '—'} %` },
              { label: 'Calidad*', value: `${section.oee?.calidad ?? '—'} %` },
            ].map((m) => (
              <div class="rounded-2xl border border-ulogix-line bg-black/35 p-5 md:p-6 hover:border-ulogix-accent/40 transition-colors">
                <p class="text-xs uppercase tracking-wider text-bs-foreground-dark mb-2">{m.label}</p>
                <p class="font-display text-3xl md:text-4xl text-white">{m.value}</p>
              </div>
            ))}
          </div>
          {section.notes && (
            <div class="grid md:grid-cols-2 gap-4 max-w-4xl">
              {section.notes.map((n) => (
                <p class="text-sm text-bs-foreground-dark leading-relaxed border-l border-ulogix-accent/40 pl-4">{n}</p>
              ))}
            </div>
          )}
        </div>
      )}

      {section.type === 'steps' && (
        <div class="grid md:grid-cols-2 gap-6 max-w-5xl">
          {section.items.map((item, i) => (
            <div class:list={[
              'relative rounded-3xl border border-ulogix-line bg-black/30 p-6 md:p-8',
              i % 2 === 1 && 'md:translate-y-8',
            ]}>
              <span class="absolute -top-3 left-6 px-3 py-1 rounded-full text-xs font-mono bg-ulogix-accent-strong text-white">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="text-xl font-medium mb-3 mt-2">{item.title}</h3>
              <p class="text-bs-foreground-dark leading-relaxed text-sm md:text-base">{item.desc}</p>
            </div>
          ))}
        </div>
      )}

      {section.type === 'finance' && (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
          {section.items.map((item) => (
            <FlipCard
              frontMeta={item.label}
              frontTitle={item.value}
              backTitle={item.label}
              backBody={item.detail || item.value}
            />
          ))}
        </div>
      )}

      {section.type === 'cells' && (
        <div class="grid lg:grid-cols-2 gap-6 md:gap-8">
          {section.items.map((cell, i) => (
            <article class:list={[
              'rounded-3xl border border-ulogix-line overflow-hidden bg-black/35',
              i === 1 && 'lg:translate-y-6',
            ]}>
              <header class="p-6 md:p-8 border-b border-ulogix-line bg-gradient-to-r from-ulogix-accent/10 to-transparent">
                <p class="font-mono text-xs text-ulogix-accent tracking-wider uppercase mb-2">{cell.tag}</p>
                <h3 class="bs-h3">{cell.name}</h3>
              </header>
              <div class="p-6 md:p-8">
                <p class="text-bs-foreground-dark leading-relaxed mb-6">{cell.body}</p>
                <ul class="flex flex-wrap gap-2">
                  {cell.highlights.map((h) => (
                    <li class="text-xs border border-ulogix-line px-3 py-1.5 rounded-full text-bs-foreground-light">{h}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      )}

      {section.type === 'risks' && (
        <div class="grid md:grid-cols-2 gap-4">
          {section.items.map((row) => (
            <FlipCard
              frontTitle={row.risk}
              frontMeta="Riesgo"
              backTitle="Mitigación"
              backBody={row.mitigation}
            />
          ))}
        </div>
      )}

      {section.type === 'split' && (
        <div class="grid md:grid-cols-2 gap-5">
          {[section.left, section.right].map((col) => (
            <div class="rounded-3xl border border-ulogix-line bg-black/30 p-6 md:p-8">
              <h3 class="text-xl font-medium mb-6 text-white">{col.title}</h3>
              <ul class="flex flex-col gap-3">
                {col.items.map((item) => (
                  <li class="flex gap-3 text-bs-foreground-dark text-sm md:text-base">
                    <span class="text-ulogix-accent shrink-0">▸</span>{item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}

      {section.type === 'demo' && (
        <DemoPanel demoId={demoId} title={section.title} body={section.body} />
      )}
    </section>
  ))}
</div>
